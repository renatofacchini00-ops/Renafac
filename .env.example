# Crie um arquivo .env na raiz do projeto com estas variáveis:

# Token SPTrans Olho Vivo (obtenha em https://www.sptrans.com.br/desenvolvedores/)
EXPO_PUBLIC_SPTRANS_TOKEN=seu_token_sptrans_aqui

# Chave Google Maps (obtenha em https://console.cloud.google.com/)
# Habilite: Maps SDK for Android, Maps SDK for iOS, Directions API, Geocoding API
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=sua_chave_google_maps_aqui
